{
  "name": "nen-gatsby-jest-proof",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand --json --outputFile=jest-results.json",
    "coverage": "node node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand --coverage --coverageReporters=lcov --coverageDirectory=coverage"
  },
  "dependencies": {
    "gatsby": "5.16.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "babel-jest": "29.7.0",
    "babel-preset-gatsby": "3.16.0",
    "@babel/core": "7.26.0",
    "identity-obj-proxy": "3.0.0",
    "@testing-library/react": "16.1.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "jest-environment-jsdom": "29.7.0"
  }
}
