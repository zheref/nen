{
  "$comment": "TEST FIXTURE (zheref/nen#338) -- the $-metadata guarantee. Every object in this file carries a $-prefixed key named after its own first key and a $note of a different JSON type, so each loader is proved to ignore them as data; declarations.test.ts loads it beside a copy with every $ key stripped and requires the same model. Derived from bankai-repo/nen/contract.json.",
  "$dependency": "metadata named after 'dependency'",
  "$schema": "nen.contract/v0.1",
  "dependency": {
    "$name": "metadata named after 'name'",
    "name": "nen",
    "source": "zheref/nen",
    "repository": "https://github.com/zheref/nen",
    "minimum": "0.3",
    "minimum_semantics": "MAJOR.MINOR. While nen's line is 0.x this means >=0.3.0 <0.4.0 EXACTLY -- at major zero the MINOR is the breaking-change vehicle, so a higher minor is out of range in both directions.",
    "zero_major_caveat": {
      "$applies_while": "metadata named after 'applies_while'",
      "$comment": "An unknown key, preserved verbatim and read by nothing in nen. Its presence in this fixture is the proof of that rule.",
      "applies_while": "the installed and pinned majors are both 0",
      "rule": "minimum '0.3' resolves to the range >=0.3.0 <0.4.0.",
      "$note": "an annotation, read by no loader"
    },
    "pinned_ref": "v0.3.0",
    "version_probe": [
      "nen",
      "--version"
    ],
    "version_probe_output": "a bare semver on stdout, e.g. '0.3.0' -- no 'v' prefix, no other text",
    "bootstrap": {
      "$vendored": "metadata named after 'vendored'",
      "vendored": false,
      "script_path_in_source": "bootstrap/nen.sh",
      "url": "https://raw.githubusercontent.com/zheref/nen/v0.3.0/bootstrap/nen.sh",
      "fetch_must_be_two_step": true,
      "published_binaries": [
        "nen-linux-x64",
        "nen-darwin-arm64",
        "nen-windows-x64.exe"
      ],
      "manifest_asset": "SHA256SUMS",
      "$note": 7
    },
    "no_improvised_fallback": "Unsatisfied means re-pin to pinned_ref and halt. There is no third path.",
    "$note": true
  },
  "project": {
    "$scenario": "metadata named after 'scenario'",
