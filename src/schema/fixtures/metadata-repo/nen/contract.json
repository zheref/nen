        "$note": 7
      },
      "java": {
        "$version": "metadata named after 'version'",
        "version": "21",
        "probe": [
          "java",
          "-version"
        ],
        "versionFrom": "first-semver-on-stderr",
        "installer": "verify-only",
        "why": "java -version writes to stderr. Two JDKs in one tree is the android lane's own problem to order.",
        "$note": true
      },
      "$note": null
    },
    "preconditions": {
